# ============================================================
# Tally Copilot Server — template. Copy to ".env", then fill every
# "change-me" value. Lines starting with # are comments.
# "You invent" = type anything. "Must match" = EXACT same text in 2 places.
# ============================================================

# --- App basics (you decide) ---
# NODE_ENV: "development" on your laptop, "production" on Render.
NODE_ENV=development
# PORT: you pick locally. On Render leave it — Render injects its own PORT itself.
PORT=4000
# CORS_ORIGIN: the website allowed to call this server.
# Your client URL — http://localhost:5173 locally, https://<your-site>.pages.dev on Cloudflare Pages.
CORS_ORIGIN=http://localhost:5173

# --- Login tokens (you generate — run once, paste output) ---
# Get it: in this folder run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep .env private — anyone with this string can forge logins.
JWT_SECRET=change-me-generate-with-crypto-randombytes
# JWT_EXPIRES_IN: login lifetime. Examples: 8h, 24h, 7d.
JWT_EXPIRES_IN=8h
# VIEW_AS_TOKEN_MINUTES: how long an Admin "View as user" preview token lives.
VIEW_AS_TOKEN_MINUTES=15
# BCRYPT_ROUNDS: password-hash strength. 10 = default.
BCRYPT_ROUNDS=10
# LOGIN_MAX_FAILURES: wrong-password attempts before lockout.
LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES: lockout length (auto-unlocks after this; instant unlock with: npm run unlock -- <email>).
LOGIN_LOCK_MINUTES=15
# SETUP_ENABLED: reserved — nothing reads it today. Leave as-is.
SETUP_ENABLED=true

# --- First-run admin (you invent — ONLY way an admin is made) ---
# No signup page exists: on boot the server creates company + admin from these lines.
# Change the password before shared hosting.
ADMIN_NAME=Owner
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
COMPANY_NAME=My Company Pvt Ltd
# COMPANY_GSTIN: from YOUR GST certificate or gst.gov.in → Search Taxpayer (15 chars).
COMPANY_GSTIN=
# COMPANY_STATE: YOUR 2-digit GST state code (27 Maharashtra, 29 Karnataka, 07 Delhi…).
COMPANY_STATE=27

# --- AI: Kaggle notebook ONLY ---
LLM_PROVIDER=kaggle
# LLM_API_KEY: YOU INVENT (generate like JWT_SECRET). Must match Kaggle Secret "LLM_API_KEY".
LLM_API_KEY=change-me
# LLM_MODEL: fixed — must match notebook Cell 3 --served-model-name.
LLM_MODEL=tally-vl
# LLM_TIMEOUT_MS: GPU wait per request (60000 = 60s).
LLM_TIMEOUT_MS=60000
# LLM_BASE_URL_BOOTSTRAP: copied from NOTEBOOK Cell 4 "TUNNEL_URL = https://....trycloudflare.com". Normally EMPTY.
LLM_BASE_URL_BOOTSTRAP=
# INTERNAL_REGISTER_SECRET: YOU INVENT. Must match Kaggle Secret "INTERNAL_REGISTER_SECRET".
INTERNAL_REGISTER_SECRET=change-me-too

# --- Free hosted AI for demos (pick one or chain several, comma-separated) ---
# LLM_PROVIDERS: order to try — first working answer wins: gemini, groq, openrouter, kaggle.
LLM_PROVIDERS=gemini,kaggle
# GEMINI_API_KEY: FREE no card — aistudio.google.com → Get API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# GROQ_API_KEY: FREE no card — console.groq.com → API Keys. Text only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_API_KEY: :free models cost nothing — openrouter.ai → Keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct:free

# --- Tally connector (you invent; must match connector's .env on the Tally machine) ---
CONNECTOR_API_KEY=change-me-three

# --- Limits (you decide) ---
MAX_UPLOAD_MB=10
QUERY_ROW_LIMIT=200
QUERY_TIMEOUT_MS=5000
DEFAULT_DAILY_CHAT_CAP=30
DEFAULT_DAILY_BILL_CAP=20

# --- Database: development = local SQLite, production = TiDB Cloud ---
# DB_DRIVER: "sqlite" on your laptop (zero setup), "tidb" in production.
# The server reads ONLY the section matching DB_DRIVER — fill just one.
DB_DRIVER=sqlite

# --- Dev database (DB_DRIVER=sqlite — file on disk, no account needed) ---
DB_FILE=./data/tally.db

# --- Production database (DB_DRIVER=tidb — TiDB Cloud free tier) ---
# Get them: tidbcloud.com → your cluster → Connect → "Connection string".
# TIDB_HOST: the cluster endpoint, e.g. gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_HOST=
# TIDB_PORT: almost always 4000.
TIDB_PORT=4000
# TIDB_USER: looks like 4AbC5dEf.user — copy the whole "User" line.
TIDB_USER=
# TIDB_PASSWORD: the password you set when creating the cluster (NOT your TiDB Cloud login).
TIDB_PASSWORD=
# TIDB_DATABASE: schema name the server creates/uses (default: tally).
TIDB_DATABASE=tally
# TIDB_SSL: keep true — TiDB Cloud requires TLS.
TIDB_SSL=true
# DATABASE_URL (optional shortcut — overrides the TIDB_* lines above):
# mysql://USER:PASSWORD@HOST:4000/tally
# DATABASE_URL=
